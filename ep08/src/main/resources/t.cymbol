// EP08 Sample: Three-address code generation
int add(int a, int b) {
    int sum = a + b;
    return sum;
}

int compute(int x, int y) {
    int t1 = x * y;
    int t2 = t1 + x;
    int t3 = t2 - y;
    return t3;
}

void main() {
    int a = 10;
    int b = 20;
    int c = add(a, b);
    int d = compute(c, a);
}
